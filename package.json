{
  "name": "porkbun-axi",
  "version": "0.1.0",
  "description": "AXI-compliant CLI for safe, agent-ergonomic Porkbun domain management.",
  "type": "module",
  "bin": {
    "porkbun-axi": "bin/porkbun-axi.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "pretest": "npm run build",
    "test": "vitest run",
    "skill:gen": "node scripts/gen-skill.mjs",
    "skill:check": "node scripts/gen-skill.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
